PARECUT_APP_ENV=dev
PARECUT_SECRET_KEY=dev-only-insecure-secret-change-me
PARECUT_DATABASE_URL=sqlite+aiosqlite:///./var/parecut.db
PARECUT_STORAGE_DIR=var/storage
PARECUT_PUBLIC_BASE_URL=http://localhost:8000
PARECUT_STORAGE_BACKEND=local
PARECUT_R2_ACCOUNT_ID=
PARECUT_R2_ACCESS_KEY_ID=
PARECUT_R2_SECRET_ACCESS_KEY=
PARECUT_R2_BUCKET=
PARECUT_R2_ENDPOINT_URL=
PARECUT_R2_REGION=auto
PARECUT_PIPELINE_RUNNER=mock
PARECUT_RUNPOD_API_KEY=
PARECUT_RUNPOD_AUDIO_ENDPOINT_ID=
PARECUT_RUNPOD_SEPARATE_ENDPOINT_ID=
PARECUT_RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
PARECUT_RUNPOD_POLL_INTERVAL_SECONDS=2
PARECUT_RUNPOD_JOB_TIMEOUT_SECONDS=14400
PARECUT_RUNPOD_URL_TTL_SECONDS=21600
PARECUT_RUNPOD_REQUEST_TIMEOUT_SECONDS=30
PARECUT_SESSION_COOKIE=parecut_session
PARECUT_SESSION_TTL_DAYS=7
PARECUT_SIGNUP_BONUS_MINUTES=30
PARECUT_MAX_UPLOAD_BYTES=2147483648
PARECUT_UPLOAD_URL_TTL_SECONDS=900
PARECUT_DOWNLOAD_URL_TTL_SECONDS=900
PARECUT_MOCK_STAGE_DELAY_MS=1500
PARECUT_SEED_DEMO=true
PARECUT_FRONTEND_DIST=web/dist
